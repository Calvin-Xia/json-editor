{
  "name": "json-editor",
  "version": "1.0.0",
  "description": "JSON/JSON5 Editor - Windows desktop application for visual editing of JSON/JSON5 files",
  "main": "dist/electron/main.js",
  "author": "Calvin-Xia",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.node.json",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:8082 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:portable": "npm run build && electron-builder --win dir && pwsh -Command \"Compress-Archive -Path 'release/win-unpacked/*' -DestinationPath 'release/JSON-Editor-portable.zip' -Force\"",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:electron": "tsc --project tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croct/json5-parser": "^0.2.2",
    "diff": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zundo": "^2.3.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.json-editor.app",
    "productName": "JSON Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
